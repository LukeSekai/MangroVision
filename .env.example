# PostgreSQL application connection. Use Supabase's session pooler in deployment.
DATABASE_URL=postgresql+psycopg://mangrovision:mangrovision@127.0.0.1:5432/mangrovision
APP_DATABASE_ROLE=mangrovision
# Direct/owner connection used only by Alembic, migration, backup, and restore jobs.
MIGRATION_DATABASE_URL=postgresql+psycopg://mangrovision_owner:mangrovision_owner@127.0.0.1:5432/mangrovision
DB_SCHEMA=mangrovision
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_SSLMODE=disable

# S3-compatible object storage. Local values target the MinIO Docker service.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mangrovision
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_BUCKET=analysis-images
S3_PRESIGNED_URL_TTL_SECONDS=900
S3_FORCE_PATH_STYLE=true

# Cookie/security settings. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STAFF_SESSION_HOURS=12
PLANTER_SESSION_DAYS=7

# One-time bootstrap values. Remove these after running scripts/bootstrap_admin.py.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Frozen SQLite source used only by the one-time migration command.
SQLITE_MIGRATION_SOURCE=planting_zones.db

# Copy the shared GeoTIFF to MAP/FINAL/final_orthophoto.tif. The default path
# needs no setting; use this only if you keep the file elsewhere.
# MANGROVISION_ORTHO_PATH=MAP/FINAL/final_orthophoto.tif

# Optional walking/driving route service. Leave blank for map-only navigation.
GOOGLE_ROUTES_API_KEY=

# Optional. WorldTides is preferred when configured; otherwise the tide route
# automatically uses Open-Meteo's keyless marine forecast.
WORLDTIDES_API_KEY=

# Staff codes prefer the configured Supabase cloud sender over HTTPS.
# auto uses SMTP if no cloud sender is configured; cloud requires it.
# Choose smtp only on networks that permit SMTP connections.
STAFF_EMAIL_TRANSPORT=auto
# SMTP remains available for staff codes and monitoring reminders.
# Each staff account needs its own real verification address in users.email.
# Monitoring email: three days before, one day before, and on the weekday visit.
# Run scripts/send_monitoring_reminders.py daily on a host with database access.
# Brevo: copy the SMTP login and SMTP key from Settings > SMTP & API.
# SMTP_FROM must be a verified sender (preferably on an authenticated domain).
LGU_REMINDER_EMAIL=mangrovision.lgu@gmail.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
